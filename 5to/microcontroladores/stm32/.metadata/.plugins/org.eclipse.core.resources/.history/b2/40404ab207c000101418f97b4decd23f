/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  MX_I2C2_Init();
  /* USER CODE BEGIN 2 */

  // Start PWM output for TIM2 Channel 1 (servo)
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);
  GROVE_LCD_Init(&hi2c1);
  GROVE_LCD_WriteString("Hello World");
  // Explicitly set the servo to its initial center position
  // (Matches the 'position' variable and the timer's 'Pulse' setting)
  Servo_SetPulseUS(position);

  // Start the first ADC conversion with interrupt
  HAL_ADCEx_InjectedStart_IT(&hadc1);

  // Use uint16_t for 12-bit ADC results
  uint16_t sensor_left = 0;
  uint16_t sensor_right = 0;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

	      // Check if the ADC has finished converting
	      if (conversion_flag)
	      {
	      	conversion_flag = 0; // Clear the flag immediately

	      	// 1. Read the sensor values
	        // RANK_1 = ADC_CHANNEL_3 = sensor_right
	        // RANK_2 = ADC_CHANNEL_4 = sensor_left
	      	sensor_right = (uint16_t)(HAL_ADCEx_InjectedGetValue(&hadc1, ADC_INJECTED_RANK_1) & ADC_READ_MASK);
	      	sensor_left  = (uint16_t)(HAL_ADCEx_InjectedGetValue(&hadc1, ADC_INJECTED_RANK_2) & ADC_READ_MASK);

	        // 2. Calculate the error (difference)
	        // A positive 'diff' means Left is brighter.
	        // A negative 'diff' means Right is brighter.
	        int32_t diff = (int32_t)sensor_left - (int32_t)sensor_right;

	      	// 3. Apply Proportional Control logic with tolerance (dead-zone)
	          // Only make a move if the difference is outside the noise tolerance.
	      	if (abs(diff) > ADC_TOLERANCE)
	      	{
	      		// Calculate the adjustment step.
	              // The step is proportional to the error (diff).
	      		int32_t step = (diff * SERVO_KP_NUMERATOR) / SERVO_KP_DENOMINATOR;

	            // Apply the step
	            // - If diff is positive (light is left), step is positive. We subtract to move left.
	            // - If diff is negative (light is right), step is negative. We subtract a negative (add) to move right.
	      		position -= step;
	      	}
	          // else: (abs(diff) <= ADC_TOLERANCE)
	          // Sensors are roughly equal, do nothing to prevent jitter.

	          // 4. Clamp the position variable itself
	          // This prevents 'position' from "winding up" past the limits.
	          if (position < SERVO_MIN_US)
	          {
	              position = SERVO_MIN_US;
	          }
	          if (position > SERVO_MAX_US)
	          {
	              position = SERVO_MAX_US;
	          }

	      	// 5. Update the servo's physical position
	      	Servo_SetPulseUS(position);

	          // 6. Wait 10ms to let the servo move and stabilize before sampling again.
	          // This is a simple and effective way to dampen the system.
	      	HAL_Delay(10);

	      	// 7. Start the next ADC conversion
	      	HAL_ADCEx_InjectedStart_IT(&hadc1);
	      }
	    }
  /* USER CODE END 3 */
}

