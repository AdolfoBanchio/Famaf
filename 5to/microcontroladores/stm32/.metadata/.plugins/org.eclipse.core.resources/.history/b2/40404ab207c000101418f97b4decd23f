volatile uint32_t conversion_flag = 0;

// 'position' doesn't need to be volatile, as it's not used in the ISR.
// uint16_t is sufficient for pulse widths (500-2500).
// Initialize to the center position (1500us is default PWM pulse).
static uint16_t position = 1500;
