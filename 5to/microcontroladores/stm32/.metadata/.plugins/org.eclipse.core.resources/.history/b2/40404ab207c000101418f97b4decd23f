// Servo control defines
#define SERVO_MIN_US  (500u)
#define SERVO_MAX_US  (2500u)
#define ADC_READ_MASK (0x0FFF) // 12-bit ADC mask

// --- Dead-zone to prevent jitter ---
// If the absolute difference is less than this, do nothing.
// Adjust based on your sensor noise.
#define ADC_TOLERANCE (50)

// --- Proportional Control Gain (Kp) ---
// This scales the ADC difference (error) to a servo step.
// Kp = SERVO_KP_NUMERATOR / SERVO_KP_DENOMINATOR
// A larger Kp (e.g., 1/30) makes the tracker faster/more aggressive.
// A smaller Kp (e.g., 1/50) makes the tracker slower/smoother.
// Start with 1/40.
#define SERVO_KP_NUMERATOR   (1)
#define SERVO_KP_DENOMINATOR (40)

/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

