    	HAL_ADCEx_InjectedStart_IT(&hadc1);

    	if(sensor1_val < sensor2_val){
    		position--;
    		Servo_SetPulseUS(position);
    	}else if (sensor1 > sensor2_val){
    		position++;
    		Servo_SetPulseUS(position);
