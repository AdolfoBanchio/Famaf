// Servo control using TIM2 CH1 PWM
// TIM2 configured for 20ms period (ARR=19999) and 1us tick (PSC=7)
// Servo pulse range: 0.5ms (500us) to 2.5ms (2500us)
#define SERVO_MIN_US  (500u)
#define SERVO_MAX_US  (2500u)
#define SERVO_STEP_US (10u)
#define SERVO_STEP_DELAY_MS (20u)

volatile uint32_t conversion_flag = 0;
volatile uint32_t position = 1500;

static inline void Servo_SetPulseUS(uint16_t us)
{
  if (us < SERVO_MIN_US) us = SERVO_MIN_US;
  if (us > SERVO_MAX_US) us = SERVO_MAX_US;
  __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, us);
}

void HAL_ADCEx_InjectedConvCpltCallback(ADC_HandleTypeDef* hadc){
	conversion_flag = 1;
}

